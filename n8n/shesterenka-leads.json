      "parameters": {
        "jsCode": "// Серверная проверка заявки: данным из браузера не доверяем,\n// клиентскую валидацию можно обойти прямым запросом к вебхуку.\nconst body = $input.first().json.body ?? {};\nconst TZ = 'Europe/Moscow';\n// Режим работы из регламента: день недели (0 — вс) → [открытие, закрытие]. Совпадает с content/site.json\nconst SCHEDULE = { 1: [9, 19], 2: [9, 19], 3: [9, 19], 4: [9, 19], 5: [9, 19], 6: [10, 17] };\n\n// Убираем управляющие символы и лишние пробелы, ограничиваем длину\nconst clean = (value, max) => String(value ?? '')\n  .replace(/[\\u0000-\\u001F\\u007F]+/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, max);\n\nconst lead = {\n  name: clean(body.name, 60),\n  phone: clean(body.phone, 20).replace(/[^\\d+]/g, ''),\n  car: clean(body.car, 60),\n  service: clean(body.service, 80),\n  problem: clean(body.problem, 500),\n};\n\nconst errors = [];\nif (lead.name.length < 2 || !/^[\\p{L}\\s'-]+$/u.test(lead.name)) errors.push('name');\nif (!/^\\+7\\d{10}$/.test(lead.phone)) errors.push('phone');\nif (body.consent !== true) errors.push('consent');\n\n// Желаемый визит: рабочий день с сегодняшнего (по Москве) и не дальше 60 дней, время — в часы работы этого дня\nconst visitDate = clean(body.visitDate, 10);\nconst visitTime = clean(body.visitTime, 5);\nlet visit = '';\nif (visitDate) {\n  const today = new Date().toLocaleDateString('en-CA', { timeZone: TZ });\n  const [y, m, d] = today.split('-').map(Number);\n  const maxDate = new Date(Date.UTC(y, m - 1, d + 60)).toISOString().slice(0, 10);\n  const parsed = /^\\d{4}-\\d{2}-\\d{2}$/.test(visitDate) ? new Date(`${visitDate}T00:00:00Z`) : null;\n  const isRealDate = parsed && !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === visitDate;\n  const hours = isRealDate ? SCHEDULE[parsed.getUTCDay()] : null; // воскресенье — выходной\n  const hour = Number(visitTime.slice(0, 2));\n  const isTimeOk = !visitTime || (/^\\d{2}:00$/.test(visitTime) && hours && hour >= hours[0] && hour < hours[1]);\n\n  if (!isRealDate || !hours || visitDate < today || visitDate > maxDate || !isTimeOk) {\n    errors.push('visit');\n  } else {\n    const [vy, vm, vd] = visitDate.split('-');\n    visit = `${vd}.${vm}.${vy}${visitTime ? ` ${visitTime}` : ', время любое'}`;\n  }\n} else if (visitTime) {\n  errors.push('visit');\n}\n\nconst receivedAt = new Date().toLocaleString('ru-RU', { timeZone: TZ });\n\n// Текст для Telegram собираем здесь, а не выражением в узле Telegram: так его можно проверить как обычный JS\nconst telegramText = [\n  'Новая заявка с сайта',\n  `Имя: ${lead.name}`,\n  `Телефон: ${lead.phone}`,\n  `Услуга: ${lead.service || '—'}`,\n  `Запись: ${visit || 'не выбрана'}`,\n  `Марка: ${lead.car || '—'}`,\n  `Что случилось: ${lead.problem || '—'}`,\n  `Получена: ${receivedAt}`,\n].join('\\n');\n\nreturn [{\n  json: {\n    ok: errors.length === 0,\n    error: errors.length ? `Некорректные поля: ${errors.join(', ')}` : '',\n    ...lead,\n    visit,\n    // Время сервера, а не браузера: часы клиента могут врать\n    receivedAt,\n    telegramText,\n    status: 'Новая',\n  },\n}];\n"
      },
