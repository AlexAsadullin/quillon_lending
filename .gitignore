.DS_Store
.idea/
.vscode/
*.log

# Собранный сайт — генерируется scripts/build.mjs
dist/

# Документы автосервиса не попадают в git: репозиторий публичный.
# В git хранится только структура папок и README.
content/docs/**
!content/docs/**/
!content/docs/README.md
!content/docs/**/.gitkeep

# Документы клиента (прайс, регламент, договор, переписка) — источник фактов, в публичный git не попадают
Архив/
